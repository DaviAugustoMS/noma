# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 图谱后端（目前仅支持 zep）；实现位于 backend/app/services/graph_backend
GRAPH_BACKEND=zep
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# 模拟专用模型（可选，例如本地 Ollama）：仅用于 Agent 在模拟中的行为；
# 本体/人设/配置/报告仍使用上方 LLM_*。设置 LLM_SIM_MODEL_NAME 后生效，优先级高于 LLM_BOOST_*。
# 本地示例（Docker 内请将 localhost 换成 host.docker.internal）：
# LLM_SIM_BASE_URL=http://localhost:11434/v1
# LLM_SIM_MODEL_NAME=<本地模型名>
# LLM_SIM_API_KEY=

# 推理强度（可选）：none/minimal/low/medium/high。使用本地推理模型（如 Ollama qwen3.x）时
# 建议设为 none，可避免每次调用消耗数千隐藏 token 导致极慢。LLM_SIM_REASONING_EFFORT 仅作用于模拟。
# LLM_REASONING_EFFORT=none
# LLM_SIM_REASONING_EFFORT=none

# ===== Espelho de estado no Zeep Orbit (opcional) =====
# Sem ORBIT_BASE_URL e credenciais, nada é gravado fora do disco local.
# O backend entra como um usuário de serviço (conta criada no app, pela tela /auth).
# ORBIT_BASE_URL=https://orbit.dlec.app   # sem /{app} no final
# ORBIT_APP=mirofish
# ORBIT_SERVICE_EMAIL=
# ORBIT_SERVICE_PASSWORD=
# Fallback legado (não renovável): token de app já emitido. Não use um PAT pessoal.
# ORBIT_API_TOKEN=
# ORBIT_ORPHAN_GRACE_SECONDS=0
